# Copia como .env y reemplaza los marcadores por valores locales aleatorios.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=sqlserver://localhost:1434;database=pcdex_functional;user=sa;password=REPLACE_LOCAL_PASSWORD;encrypt=true;trustServerCertificate=true
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
TOTP_ENCRYPTION_KEY=REPLACE_WITH_ANOTHER_32_RANDOM_CHARACTERS
MSSQL_SA_PASSWORD=REPLACE_LOCAL_PASSWORD
DOCKER_DATABASE_URL=sqlserver://pcdex-db:1433;database=pcdex_functional;user=sa;password=REPLACE_LOCAL_PASSWORD;encrypt=true;trustServerCertificate=true
