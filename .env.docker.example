# Copia este archivo como .env.docker y define valores propios.
# Usa una contraseña SQL Server de al menos 8 caracteres con mayúsculas,
# minúsculas, números y símbolos; evita llaves y punto y coma.
MSSQL_SA_PASSWORD=REEMPLAZAR_CON_CLAVE_SEGURA1!
SESSION_SECRET=REEMPLAZAR_CON_AL_MENOS_32_CARACTERES_ALEATORIOS
TOTP_ENCRYPTION_KEY=REEMPLAZAR_CON_OTRA_CLAVE_ALEATORIA_DE_32_CARACTERES
FRONTEND_PORT=8080
FRONTEND_ORIGIN=http://localhost:8080
