generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Componente {
  id              String          @id @db.VarChar(100)
  nombre          String          @db.VarChar(300)
  marca           String          @db.VarChar(120)
  categoria       String          @db.VarChar(40)
  // NULL significa sin cotización. Nunca usar 0 como precio desconocido.
  precio          Decimal?        @db.Decimal(18, 2)
  procesador      Procesador?
  tarjetaGrafica  TarjetaGrafica?
  placaMadre      PlacaMadre?
  memoriaRAM      MemoriaRAM?
  fuentePoder     FuentePoder?
  almacenamiento Almacenamiento?
  gabinete        Gabinete?
  refrigeracion   Refrigeracion?
  favoritos       Favorito[]
  piezasEnsamble  PiezaEnsamble[]

  @@index([categoria, precio, id])
  @@index([marca])
}

enum RolUsuario {
  USUARIO
  ADMIN
}

model Usuario {
  id             String          @id @default(cuid()) @db.VarChar(30)
  nombre         String          @db.VarChar(120)
  email          String          @unique @db.VarChar(191)
  password_hash  String?         @db.VarChar(255)
  google_sub     String?         @unique @db.VarChar(255)
  rol            RolUsuario      @default(USUARIO)
  creado_en      DateTime        @default(now())
  actualizado_en DateTime        @updatedAt
  sesiones       Sesion[]
  favoritos      Favorito[]
  ensambles      Ensamble[]
}

model Sesion {
  id          String   @id @default(cuid()) @db.VarChar(30)
  usuario_id  String   @db.VarChar(30)
  token_hash  String   @unique @db.VarChar(128)
  creado_en   DateTime @default(now())
  expira_en   DateTime
  usuario     Usuario  @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  verificaciones VerificacionGoogle[]

  @@index([usuario_id])
  @@index([expira_en])
}

model VerificacionGoogle {
  token_hash String   @id @db.VarChar(64)
  sesion_id  String   @db.VarChar(30)
  expira_en  DateTime
  sesion     Sesion   @relation(fields: [sesion_id], references: [id], onDelete: Cascade)

  @@index([sesion_id])
  @@index([expira_en])
}

model Favorito {
  usuario_id    String     @db.VarChar(30)
  componente_id String     @db.VarChar(100)
  creado_en     DateTime   @default(now())
  usuario       Usuario    @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  componente    Componente @relation(fields: [componente_id], references: [id], onDelete: Restrict)

  @@id([usuario_id, componente_id])
  @@index([componente_id])
}

model Ensamble {
  id             String          @id @default(cuid()) @db.VarChar(30)
  usuario_id     String          @db.VarChar(30)
  nombre         String          @db.VarChar(120)
  presupuesto    Decimal?        @db.Decimal(18, 2)
  creado_en      DateTime        @default(now())
  actualizado_en DateTime        @updatedAt
  usuario        Usuario         @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  piezas         PiezaEnsamble[]

  @@index([usuario_id])
}

model PiezaEnsamble {
  ensamble_id   String     @db.VarChar(30)
  componente_id String     @db.VarChar(100)
  ensamble      Ensamble   @relation(fields: [ensamble_id], references: [id], onDelete: Cascade)
  componente    Componente @relation(fields: [componente_id], references: [id], onDelete: Restrict)

  @@id([ensamble_id, componente_id])
  @@index([componente_id])
}

model Procesador {
  componente_id String @id @db.VarChar(100)
  socket        String @db.VarChar(60)
  nucleos       Int
  tdp           Int
  componente    Componente @relation(fields: [componente_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}
model TarjetaGrafica {
  componente_id String @id @db.VarChar(100)
  vram          Decimal @db.Decimal(10, 2)
  tdp           Int
  componente    Componente @relation(fields: [componente_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}
model PlacaMadre {
  componente_id String @id @db.VarChar(100)
  socket        String @db.VarChar(60)
  tipo_ram      String @db.VarChar(40)
  formato       String @db.VarChar(60)
  componente    Componente @relation(fields: [componente_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}
model MemoriaRAM {
  componente_id String @id @db.VarChar(100)
  tipo          String @db.VarChar(40)
  capacidad     Int
  componente    Componente @relation(fields: [componente_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}
model FuentePoder {
  componente_id String @id @db.VarChar(100)
  vatios        Int
  certificacion String @db.VarChar(100)
  componente    Componente @relation(fields: [componente_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}
model Almacenamiento {
  componente_id String @id @db.VarChar(100)
  tipo          String @db.VarChar(60)
  capacidad     Int
  componente    Componente @relation(fields: [componente_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}
model Gabinete {
  componente_id String @id @db.VarChar(100)
  formato       String @db.VarChar(60)
  componente    Componente @relation(fields: [componente_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}
model Refrigeracion {
  componente_id String @id @db.VarChar(100)
  tipo          String @db.VarChar(60)
  tdp_soportado Int?
  componente    Componente @relation(fields: [componente_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}
