NODE_ENV=development
HOST=127.0.0.1
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=mysql://pcdex:REPLACE_PASSWORD@127.0.0.1:3307/pcdex
DOCKER_DATABASE_URL=mysql://pcdex:REPLACE_PASSWORD@pcdex-db:3306/pcdex
MYSQL_PASSWORD=REPLACE_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_DIFFERENT_ROOT_PASSWORD
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
TOTP_ENCRYPTION_KEY=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
APP_HOST_PORT=8081
APP_ORIGIN=http://localhost:8081

# Google OAuth: configura un cliente web y no compartas el secreto.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8081/api/auth/google/callback

# Gmail de PCdex para verificación: usa contraseña de aplicación.
SMTP_USER=
SMTP_PASSWORD=
EMAIL_CODE_SECRET=
REQUIRE_EMAIL_VERIFICATION=false
