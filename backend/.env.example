# Configura valores propios antes de ejecutar la API o Docker.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
DATABASE_URL="sqlserver://localhost:1433;database=pcdex;user=sa;password={REEMPLAZAR_PASSWORD};encrypt=true;trustServerCertificate=true"
SQLSERVER_PASSWORD=REEMPLAZAR_PASSWORD
MSSQL_SA_PASSWORD=REEMPLAZAR_PASSWORD
SESSION_SECRET=REEMPLAZAR_CON_AL_MENOS_32_CARACTERES_ALEATORIOS
TOTP_ENCRYPTION_KEY=REEMPLAZAR_CON_OTRA_CLAVE_ALEATORIA_DE_32_CARACTERES
GENERATION_MAX_NODES=250000
GENERATION_TIMEOUT_MS=3000
BUILDCORES_FILE=data/buildcores.json
PRICES_FILE=data/precios-cop.json
